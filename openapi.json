  "info": {
    "title": "snack-store-api",
    "description": "API REST para un sistema de venta de comestibles en línea",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Introduce tu token JWT (POST /api/auth/login)"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan.perez@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "MiClaveSegura123!"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Juan"
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Pérez"
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "+56912345678"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan.perez@example.com"
          },
          "password": {
            "type": "string",
            "example": "MiClaveSegura123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Frutas Frescas"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Si no se envía, se genera automáticamente desde el nombre",
            "example": "frutas-frescas"
          },
          "description": {
            "type": "string",
            "example": "Frutas de temporada"
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "description": "Id de la categoría padre (para subcategorías)",
            "example": "8b1a2d5e-1111-1111-1111-111111111111"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Frutas Importadas"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "example": "frutas-importadas"
          },
          "description": {
            "type": "string",
            "description": "Enviar null para limpiar",
            "example": "Nueva descripción",
            "nullable": true
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "description": "Enviar null para quitar la categoría padre",
            "example": "8b1a2d5e-1111-1111-1111-111111111111",
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "Id de la categoría del producto",
            "example": "8b1a2d5e-1111-1111-1111-111111111111"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "MANZ-001"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Manzana Roja"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Si no se envía, se genera automáticamente desde el nombre",
            "example": "manzana-roja"
          },
          "description": {
            "type": "string",
            "example": "Manzanas rojas de exportación"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999,
            "example": 2.5
          },
          "salePrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999,
            "description": "Debe ser menor que price",
            "example": 1.99
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "Unidad de venta: kg, g, litro, unidad, pack…",
            "example": "kg"
          },
          "isPerishable": {
            "type": "boolean",
            "example": true,
            "default": false
          },
          "isOrganic": {
            "type": "boolean",
            "example": true,
            "default": false
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://cdn.example.com/manzana.jpg"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "sku",
          "name",
          "price",
          "unit"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "Enviar null para quitar la categoría",
            "example": "8b1a2d5e-1111-1111-1111-111111111111",
            "nullable": true
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "MANZ-002"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Manzana Golden"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "example": "manzana-golden"
          },
          "description": {
            "type": "string",
            "description": "Enviar null para limpiar",
            "example": "Nueva descripción",
            "nullable": true
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999,
            "example": 3.2
          },
          "salePrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999,
            "description": "Debe ser menor que price · enviar null para limpiar",
            "example": 2.5,
            "nullable": true
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "kg"
          },
          "isPerishable": {
            "type": "boolean",
            "example": true
          },
          "isOrganic": {
            "type": "boolean",
            "example": true
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Enviar null para limpiar",
            "example": "https://cdn.example.com/manzana.jpg",
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "example": false
          }
        }
      },
