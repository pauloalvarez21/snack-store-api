# ==============================================
# snack-store-api — Variables de entorno (ejemplo)
# Copia este archivo a .env y completa los valores reales
# ==============================================

# --- Base de datos PostgreSQL (Neon o local) ---
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# --- JWT ---
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
# Vida del refresh token (se rota en cada uso): 7d, 12h, 30m, 3600…
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Servidor ---
PORT=3000

# --- CORS ---
# Orígenes permitidos para llamar a la API (separados por coma).
# Default: http://localhost:4200 (frontend Angular en desarrollo).
# Cuando subas el proyecto, añade tu dominio: CORS_ORIGINS=http://localhost:4200,https://tu-dominio.com
CORS_ORIGINS=http://localhost:4200,https://gaelectronica.free.je

# --- Pagos (billeteras del comercio) ---
# Números donde tus clientes hacen el pago con Nequi / Daviplata.
# Se muestran en el pedido (campo payment.walletNumber) al elegir ese método.
PAYMENT_NEQUI_NUMBER=3001234567
PAYMENT_DAVIPLATA_NUMBER=3011234567
